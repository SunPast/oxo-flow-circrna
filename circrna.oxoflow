# circRNA Detection Pipeline
# Built on oxo-flow engine
#
# QUICK START:
#   1. Set reference_dir below to your genome directory
#   2. Place FASTQ files in raw/
#   3. oxo-flow run circrna.oxoflow -j 16
#
# Indexes are auto-built on first run. Environments are auto-created.

[workflow]
name = "circrna"
version = "1.0.0"
description = "circRNA detection and analysis pipeline"
author = "oxo-flow-circrna"
format_version = "1.0"
sample_pattern = "raw/{sample}_1.fastq.gz"

[config]
# === The only path you need to set ===
# All indexes and reference paths are auto-derived from this directory.
# Expected layout:
#   {reference_dir}/genome.fa
#   {reference_dir}/genes.gtf
reference_dir = "/data/references/GRCh38"

# === Optional overrides (uncomment if your layout differs) ===
# reference_fasta = "/data/references/GRCh38/genome.fa"
# gene_annotation = "/data/references/GRCh38/genes.gtf"
# circexplorer2_ref = "/data/references/GRCh38/hg38_ref.txt"

# Sample sheet (auto-generated: bash generate_sample_list.sh)
samples = "samples.csv"

[defaults]
threads = 8
memory = "16G"

# === Auto-built references ===
# oxo-flow builds these automatically on first run. No manual steps needed.

[[references]]
name = "bwa_index"
source = "{config.reference_fasta}"
output = "{config.reference_dir}/bwa/genome.fa"
build = "mkdir -p {config.reference_dir}/bwa && bwa index -p {output} {source}"
threads = 8
description = "BWA index for CIRIquant and CIRCexplorer2"

[[references]]
name = "bowtie2_index"
source = "{config.reference_fasta}"
output = "{config.reference_dir}/bowtie2/genome.fa"
build = "mkdir -p {config.reference_dir}/bowtie2 && bowtie2-build {source} {output}"
threads = 8
description = "Bowtie2 index for find_circ"

[[references]]
name = "star_index"
source = "{config.reference_fasta}"
output = "{config.reference_dir}/star"
build = "mkdir -p {output} && STAR --runMode genomeGenerate --genomeDir {output} --genomeFastaFiles {source} --sjdbGTFfile {config.gene_annotation} --runThreadN 16"
memory = "64G"
description = "STAR index for circRNA_finder (large: ~30 GB, ~2-6 hours)"

[[references]]
name = "hisat2_index"
source = "{config.reference_fasta}"
output = "{config.reference_dir}/hisat2/genome.fa"
build = "mkdir -p {config.reference_dir}/hisat2 && hisat2-build {source} {output}"
threads = 8
description = "HISAT2 index for CIRIquant"

# === Sub-workflows ===
[[include]]
path = "rules/qc.oxoflow"

[[include]]
path = "rules/callers.oxoflow"

[[include]]
path = "rules/annotation.oxoflow"

[[include]]
path = "rules/aggregation.oxoflow"

[[include]]
path = "rules/report.oxoflow"

# circRNA Detection Pipeline
# Built on oxo-flow engine
#
# QUICK START:
#   1. ./scripts/setup.sh
#   2. Edit config.toml with your reference paths
#   3. oxo-flow run circrna.oxoflow -j 16

[workflow]
name = "circrna"
version = "1.0.0"
description = "circRNA detection and analysis pipeline"
author = "oxo-flow-circrna"
format_version = "1.0"
sample_pattern = "raw/{sample}_1.fastq.gz"
# Set this to your reference directory to auto-derive standard paths.
# When set, reference_fasta, gene_annotation, bwa_index, bowtie2_index,
# star_index, and hisat2_index are derived automatically.
# reference_dir = "/data/references/GRCh38"

[config]
# === Reference paths ===
# Option A: Set reference_dir above — standard paths are auto-derived.
# Option B: Override individual paths below if your directory layout differs.

reference_fasta = "/data/references/GRCh38/genome.fa"
gene_annotation = "/data/references/GRCh38/genes.gtf"

# Index paths (not needed if reference_dir is set with standard layout)
bwa_index = "/data/references/GRCh38/bwa/genome.fa"
bowtie2_index = "/data/references/GRCh38/bowtie2/genome.fa"
star_index = "/data/references/GRCh38/star"
hisat2_index = "/data/references/GRCh38/hisat2/genome.fa"

# CIRCexplorer2 reference (generate: fetch_ucsc.py hg38 > hg38_ref.txt)
circexplorer2_ref = "/data/references/GRCh38/hg38_ref.txt"

# CIRIquant config (auto-generated by scripts/setup.sh)
ciriquant_config = "config/ciriquant_hg38.yml"

# Sample sheet (auto-generated by generate_sample_list.sh)
samples = "samples.csv"

[defaults]
threads = 8
memory = "16G"

# === Sub-workflows ===
[[include]]
path = "rules/qc.oxoflow"

[[include]]
path = "rules/callers.oxoflow"

[[include]]
path = "rules/annotation.oxoflow"

[[include]]
path = "rules/aggregation.oxoflow"

[[include]]
path = "rules/report.oxoflow"

# circRNA Detection Pipeline
# Built on oxo-flow engine
#
# Detects circRNAs from paired-end RNA-seq using 4 methods:
# - CIRIquant, CIRCexplorer2, find_circ, circRNA_finder
# Results are aggregated for high-confidence circRNA calls.
#
# QUICK START:
#   ./scripts/setup.sh          # Create config and environments
#   # Edit config.toml with your paths
#   oxo-flow run circrna.oxoflow -j 16

[workflow]
name = "circrna"
version = "1.0.0"
description = "circRNA detection and analysis pipeline"
author = "oxo-flow-circrna"
format_version = "1.0"

[config]
# === SIMPLE MODE: Set reference_dir, all paths derive from it ===
# Expected structure:
#   {reference_dir}/genome.fa
#   {reference_dir}/genome.fa.fai
#   {reference_dir}/genes.gtf
#   {reference_dir}/hg38_ref.txt (CIRCexplorer2)
#   {reference_dir}/bwa/ (BWA index)
#   {reference_dir}/bowtie2/ (Bowtie2 index)
#   {reference_dir}/star/ (STAR index)
#   {reference_dir}/hisat2/ (HISAT2 index)
reference_dir = ""

# === ADVANCED: Override individual paths if needed ===
# reference_fasta = ""
# gene_annotation = ""
# bwa_index = ""
# hisat2_index = ""
# bowtie2_index = ""
# star_index = ""
# circexplorer2_ref = ""

# CIRIquant config (auto-generated by setup.sh)
ciriquant_config = "config/ciriquant_hg38.yml"

# Sample sheet (format: sample,r1_fastq,r2_fastq)
samples = "samples.csv"

[defaults]
threads = 8
memory = "16G"

# === Sub-workflows (do not modify) ===
[[include]]
path = "rules/qc.oxoflow"

[[include]]
path = "rules/callers.oxoflow"

[[include]]
path = "rules/annotation.oxoflow"

[[include]]
path = "rules/aggregation.oxoflow"

[[include]]
path = "rules/report.oxoflow"
